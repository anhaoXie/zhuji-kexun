/* pages/report/report.wxss —— Tab4 报表 */

.report-page {
  padding-bottom: 24rpx;
}

/* ---------------- 批次 ---------------- */
.batch-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.batch-left {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.batch-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.batch-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.5;
}

.batch-picker {
  flex: none;
  margin-top: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  font-size: 22rpx;
  font-weight: 600;
}

/* ---------------- KPI ---------------- */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.kpi-cell {
  width: 48.5%;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #F7F9FA;
}

.kpi-label {
  font-size: 22rpx;
  color: #6B7280;
}

.kpi-value {
  margin-top: 4rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #181818;
}

.kpi-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #6B7280;
}

.kpi-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 14rpx;
  border-top: 1rpx solid #EDEFF2;
  font-size: 22rpx;
  color: #6B7280;
}

.dot-sep {
  margin: 0 12rpx;
  color: #C3CBD4;
}

/* ---------------- 六状态条形 ---------------- */
.state-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.state-label {
  flex: none;
  width: 112rpx;
  font-size: 22rpx;
  color: #3F4753;
}

.state-track {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: #F2F4F6;
  overflow: hidden;
}

.state-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 300ms ease;
}

.state-count {
  flex: none;
  width: 48rpx;
  text-align: right;
  font-size: 22rpx;
  color: #6B7280;
}

/* ---------------- 病害记录 ---------------- */
.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.record-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #181818;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-advice {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6B7280;
}

.record-right {
  flex: none;
  margin-left: 16rpx;
  text-align: right;
}

.record-conf {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6B7280;
}

/* ---------------- 待复核 ---------------- */
.review-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.review-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-btns {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.mini-btn {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid #D9DDE3;
  background: #F2F4F6;
  color: #3F4753;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-primary {
  margin-right: 12rpx;
  border-color: #07C160;
  background: #07C160;
  color: #FFFFFF;
}

.review-done {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  font-size: 22rpx;
  font-weight: 600;
}

/* ---------------- 导出 ---------------- */
.export-row {
  display: flex;
  margin-top: 8rpx;
}

.export-gap {
  margin-left: 20rpx;
}

.footer-text {
  margin: 24rpx 8rpx 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9AA1AB;
  line-height: 1.5;
}
